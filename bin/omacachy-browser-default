#!/bin/bash
set -euo pipefail

choice=${OMACACHY_BROWSER:-}
if [[ -z $choice && -r /var/lib/omacachy/state.env ]]; then
  choice=$(sed -n 's/^OMACACHY_BROWSER=//p' /var/lib/omacachy/state.env | tail -1)
fi
choice=${choice:-chromium}

case $choice in
  none)
    echo "OmaCachy: no default browser configured"
    exit 0
    ;;
  chromium) desktop=chromium.desktop ;;
  firefox) desktop=firefox.desktop ;;
  brave-bin|brave) desktop=brave-browser.desktop ;;
  zen-browser) desktop=zen-browser.desktop ;;
  helium-browser) desktop=helium-browser.desktop ;;
  *) desktop=chromium.desktop ;;
esac

if [[ ! -f "/usr/share/applications/$desktop" ]]; then
  for b in chromium.desktop firefox.desktop brave-browser.desktop zen-browser.desktop helium-browser.desktop; do
    if [[ -f "/usr/share/applications/$b" ]]; then
      desktop=$b
      break
    fi
  done
fi

[[ -f "/usr/share/applications/$desktop" ]] || exit 0
exec env -u BROWSER XDG_CURRENT_DESKTOP= xdg-settings set default-web-browser "$desktop"
