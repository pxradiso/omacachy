#!/bin/bash
# OmaCachy - Omarchy on CachyOS.
set -Eeuo pipefail

SELF=$(readlink -f "${BASH_SOURCE[0]}")
ROOT=$(cd "$(dirname "$SELF")/.." && pwd)
export OMACACHY_REPO="$ROOT"

# shellcheck source=../lib/common.sh
source "$ROOT/lib/common.sh"
# shellcheck source=../lib/identity.sh
source "$ROOT/lib/identity.sh"
# shellcheck source=../lib/detect.sh
source "$ROOT/lib/detect.sh"
# shellcheck source=../lib/desktops.sh
source "$ROOT/lib/desktops.sh"
# shellcheck source=../lib/greeter.sh
source "$ROOT/lib/greeter.sh"
# shellcheck source=../lib/tui.sh
source "$ROOT/lib/tui.sh"
# shellcheck source=../lib/repo.sh
source "$ROOT/lib/repo.sh"
# shellcheck source=../lib/packages.sh
source "$ROOT/lib/packages.sh"
# shellcheck source=../lib/overlay.sh
source "$ROOT/lib/overlay.sh"
# shellcheck source=../lib/system.sh
source "$ROOT/lib/system.sh"
# shellcheck source=../lib/user.sh
source "$ROOT/lib/user.sh"
# shellcheck source=../lib/finalize.sh
source "$ROOT/lib/finalize.sh"
# shellcheck source=../lib/doctor.sh
source "$ROOT/lib/doctor.sh"
# shellcheck source=../lib/uninstall.sh
source "$ROOT/lib/uninstall.sh"
# shellcheck source=../lib/install.sh
source "$ROOT/lib/install.sh"

usage() {
  cat <<EOF
OmaCachy $OMACACHY_VERSION - Omarchy on CachyOS

Usage: omacachy <command> [options]

Commands:
  install     install/refresh Omarchy on this CachyOS system
  update      update OmaCachy from GitHub (does not update the system)
  uninstall   remove OmaCachy hooks/guards and optionally Omarchy packages
  doctor      read-only health checks
  status      show what is installed
  version     print the OmaCachy version
  help        this help

Run 'omacachy install --help' for the install options.
EOF
}

require_omarchy() {
  pkg_installed omarchy || die "Omarchy is not installed. Run: sudo omacachy install"
}

omacachy_repo_dir() {
  printf '%s\n' "$OMACACHY_REPO"
}

omacachy_git() {
  git -C "$(omacachy_repo_dir)" "$@"
}

omacachy_update_hint() {
  local repo branch local_ref remote_ref
  repo=$(omacachy_repo_dir)
  [[ -d $repo/.git ]] || return 0
  have git || return 0
  branch=$(omacachy_git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null | sed 's#^origin/##' || true)
  [[ -n $branch ]] || branch=main
  local_ref=$(omacachy_git rev-parse --verify HEAD 2>/dev/null || true)
  remote_ref=$(omacachy_git ls-remote --heads origin "$branch" 2>/dev/null | awk '{print $1}' | head -1 || true)
  [[ -n $local_ref && -n $remote_ref ]] || return 0
  if [[ $local_ref != "$remote_ref" ]]; then
    warn "A newer OmaCachy version is available on GitHub. Run: omacachy update"
  fi
}

update_main() {
  local repo branch before after dry=0
  while (($#)); do
    case $1 in
      -n|--dry-run) dry=1; DRY_RUN=1; shift ;;
      -h|--help)
        cat <<'EOF'
Usage: omacachy update [--dry-run]

Checks GitHub for a newer OmaCachy checkout and fast-forward updates this repo only.
It does not update system packages or Omarchy. Use 'omarchy update' for that.
EOF
        return 0
        ;;
      *) die "Unknown update option: $1" ;;
    esac
  done

  repo=$(omacachy_repo_dir)
  [[ -d $repo/.git ]] || die "OmaCachy repo not found at $repo"

  if (( EUID == 0 )); then
    die "Run 'omacachy update' as your normal user (it updates the OmaCachy checkout only)"
  fi

  have git || die "git is required to update OmaCachy"
  branch=$(omacachy_git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null | sed 's#^origin/##' || true)
  [[ -n $branch ]] || branch=main

  step "OmaCachy: check GitHub for updates"
  info "Repository: $repo (branch: $branch)"
  omacachy_git fetch --quiet origin "$branch" || die "Failed to fetch updates from GitHub"

  before=$(omacachy_git rev-parse --short HEAD 2>/dev/null || echo unknown)
  after=$(omacachy_git rev-parse --short "origin/$branch" 2>/dev/null || echo unknown)

  if [[ $before == "$after" ]]; then
    success "OmaCachy is already up to date ($before)"
    return 0
  fi

  info "Update available: $before -> $after"
  if (( dry || DRY_RUN )); then
    info "would run: git -C $repo pull --ff-only origin $branch"
    return 0
  fi

  if ! omacachy_git pull --ff-only origin "$branch"; then
    die "Could not fast-forward OmaCachy. Resolve local changes in $repo and retry"
  fi

  success "OmaCachy updated: $before -> $(omacachy_git rev-parse --short HEAD)"
  info "This command updates only OmaCachy. To update system/Omarchy packages, use: omarchy update"
}

status_main() {
  local version
  version=$(pkg_version omarchy 2>/dev/null || true)

  printf 'OmaCachy:        %s\n' "$OMACACHY_VERSION"
  printf 'Channel:         %s\n' "$OMACACHY_CHANNEL"
  printf 'Omarchy:         %s\n' "${version:-not installed}"
  printf 'Repository:      %s\n' "$OMACACHY_OMARCHY_REPO"
  printf 'Hostname:        %s\n' "$(hostname 2>/dev/null || echo unknown)"
  if [[ -r /etc/os-release ]]; then
    printf 'os-release:      %s\n' "$(sed -n 's/^PRETTY_NAME=//p' /etc/os-release | head -1)"
  fi
  printf 'State:           %s\n' "$OMACACHY_STATE_FILE"
  if [[ -r $OMACACHY_STATE_FILE ]]; then
    sed 's/^/  /' "$OMACACHY_STATE_FILE"
  fi
  printf 'Overlay:         %s\n' "$OMACACHY_OVERLAY_DIR"
  [[ -d $OMACACHY_OVERLAY_DIR ]] && printf '  (%s files)\n' "$(find "$OMACACHY_OVERLAY_DIR" -type f | wc -l)"
  printf 'mkinitcpio base: %s\n' "$( [[ -r $OMACACHY_BASELINE_FILE ]] && cat "$OMACACHY_BASELINE_FILE" || echo 'not recorded')"

  if pkg_installed limine-mkinitcpio-hook; then
    printf 'Bootloader:      limine-mkinitcpio-hook installed\n'
  else
    printf 'Bootloader:      Limine not installed\n'
  fi
}

command=${1:-help}
shift || true

case $command in
  install) omacachy_update_hint || true; install_main "$@" ;;
  update) update_main "$@" ;;
  uninstall) uninstall_main "$@" ;;
  doctor) omacachy_update_hint || true; doctor_main "$@" ;;
  status) omacachy_update_hint || true; status_main ;;
  version | --version | -V) echo "OmaCachy $OMACACHY_VERSION" ;;
  help | --help | -h) usage ;;
  *)
    error "Unknown command: $command"
    usage >&2
    exit 1
    ;;
esac
